#!/bin/bash
# mbilseapps - 极简多应用管理工具

VERSION="5.28"

case "$1" in
    all-pkg-install)
        echo "• 安装依赖"
        sleep 0.1
        echo "• 检查内容"
        sleep 0.2
        echo "| 完成"
        echo "• 开始调用命令"
        echo "| APT命令"
        apt install curl wget git vim htop whiptail gh python c-script whois ruby figlet toilet proot nodejs
        echo "| Ruby命令"
        gem install lolcat
        
        echo "• 依赖包安装完成。"
        ;;
    all-mcli-install)
        echo "• 安装/补全MbilseCLI"
        sleep 0.1
        echo "• 检查内容"
        sleep 0.2
        echo "| 完成"
        echo "• 开始调用命令"
        echo "| 检测列表"
        sleep 1
        echo "| 调用CURL"
        sleep 1
        echo "| 展示安装信息并开始"
        curl -fsSL https://mbilseserv.github.io/mbilseshapp/setup.sh | sh
        echo "• 所有 CLI 安装完成。"
        ;;
    update-this)
        echo "• 更新MbilseApps库/命令包"
        sleep 0.1
        echo "• 检查连接"
        sleep 0.2
        echo "| 完成"
        echo "• 开始调用命令"
        echo "| 检测Github库"
        sleep 1
        echo "| 调用CURL"
        sleep 1
        echo "| 展示安装信息并开始"
        curl -fsSL https://mbilseserv.github.io/mbilseshapp/mbilseapps > $PREFIX/bin/mbilseapps
       echo "• 完成"
       echo "• 授予权限"
       sleep 0.2
       echo "| 开始"
       sleep 0.5
    chmod +x $PREFIX/bin/mbilseapps
       echo "• 更新完成"
    
        ;;
    -v|--version)
        echo "mbilseapps version $VERSION"
        ;;
    -h|--help|"")
        cat <<EOF
用法: mbilseapps <子命令>

子命令:
  all-pkg-install      安装所有依赖包 
  all-mcli-install     安装所有 CLI 工具 
  update-this          通过 curl 更新自身脚本
  -v, --version        显示版本信息
  -h, --help           显示此帮助信息
EOF
        ;;
    *)
        echo "错误：未知子命令 '$1'"
        echo "使用 -h 查看帮助。"
        exit 1
        ;;
esac

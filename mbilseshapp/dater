#!/bin/bash

# 定义文件路径
DIARY_FILE="$HOME/diary.txt"
TODO_FILE="$HOME/todo.txt"

# 标记符号
PENDING_MARKER="[ ]"
DONE_MARKER="[x]"

# 日期格式
DATE_FORMAT="%Y-%m-%d"

# 临时剪贴板
CLIPBOARD=""

# 工具函数：将内容中的换行转义为 \n
escape_newlines() {
    echo "$1" | sed ':a;N;$!ba;s/\n/\\n/g'
}

# 工具函数：将 \n 还原为换行
unescape_newlines() {
    echo -e "$1"
}

# 主菜单
while true; do
    echo ""
    echo "欢迎使用 Dater！"
    echo "1. 添加日记"
    echo "2. 查看日记"
    echo "3. 编辑日记"
    echo "4. 删除日记"
    echo "5. 添加待办事项"
    echo "6. 查看待办事项"
    echo "7. 编辑待办事项"
    echo "8. 删除待办事项"
    echo "9. 排序日记（按日期）"
    echo "10. 排序待办事项（按添加顺序）"
    echo "11. 设置"
    echo "12. 退出"
    read -p "请输入操作编号: " option

    case $option in
        1)  # 添加日记
            echo "请输入日记内容（多行），每行按回车，输入 ::q 保存并退出。"
            echo "其他指令：::s <命令> 执行shell，::m <标题> 更改标题，::c 复制，::p 粘贴，::d 清空内容"
            content=""
            while true; do
                read -p "> " line
                if [[ "$line" == "::q" ]]; then
                    break
                elif [[ "$line" == "::s"* ]]; then
                    cmd="${line:3}"
                    eval "$cmd"
                elif [[ "$line" == "::m"* ]]; then
                    new_title="${line:3}"
                    content="$new_title"   # 重置为标题，后续输入会追加
                    echo "标题已设为: $new_title"
                elif [[ "$line" == "::c" ]]; then
                    CLIPBOARD="$content"
                    echo "已复制当前内容"
                elif [[ "$line" == "::p" ]]; then
                    content="$CLIPBOARD"
                    echo "已粘贴剪贴板内容"
                elif [[ "$line" == "::d" ]]; then
                    content=""
                    echo "内容已清空"
                else
                    content+="$line"$'\n'
                fi
            done
            # 去除末尾多余的换行
            content="${content%$'\n'}"
            # 转义换行符并保存为一行
            escaped=$(escape_newlines "$content")
            echo "[$(date +"$DATE_FORMAT")] $escaped" >> "$DIARY_FILE"
            echo "日记已保存！"
            ;;

        2)  # 查看日记（还原换行显示）
            echo "----- 日记内容 -----"
            while IFS= read -r line; do
                if [[ "$line" =~ ^\[[0-9]{4}-[0-9]{2}-[0-9]{2}\] ]]; then
                    # 提取日期和内容
                    date_part="${line%%\] *}]"
                    rest="${line#*] }"
                    # 还原换行
                    unescaped=$(unescape_newlines "$rest")
                    echo "$date_part] $unescaped"
                else
                    echo "$line"   # 容错
                fi
            done < "$DIARY_FILE"
            ;;

        3)  # 编辑日记
            echo "----- 日记列表 -----"
            nl -w2 -s'. ' "$DIARY_FILE"
            read -p "请输入要编辑的日记编号: " line_num
            if ! [[ "$line_num" =~ ^[0-9]+$ ]] || [ "$line_num" -lt 1 ]; then
                echo "无效编号！"
                continue
            fi
            # 提取该行
            original_line=$(sed -n "${line_num}p" "$DIARY_FILE")
            if [ -z "$original_line" ]; then
                echo "编号不存在！"
                continue
            fi
            # 分离日期和内容
            if [[ "$original_line" =~ ^(\[[0-9]{4}-[0-9]{2}-[0-9]{2}\])\ (.*)$ ]]; then
                date_part="${BASH_REMATCH[1]}"
                content_escaped="${BASH_REMATCH[2]}"
                content=$(unescape_newlines "$content_escaped")
            else
                echo "格式错误，无法解析！"
                continue
            fi
            echo "当前内容（日期 $date_part）："
            echo "$content"
            echo "请输入新内容（多行），输入 ::q 保存，::c 复制，::p 粘贴，::d 清空"
            new_content=""
            while true; do
                read -p "> " line
                if [[ "$line" == "::q" ]]; then
                    break
                elif [[ "$line" == "::c" ]]; then
                    CLIPBOARD="$new_content"
                    echo "已复制"
                elif [[ "$line" == "::p" ]]; then
                    new_content="$CLIPBOARD"
                    echo "已粘贴"
                elif [[ "$line" == "::d" ]]; then
                    new_content=""
                    echo "已清空"
                else
                    new_content+="$line"$'\n'
                fi
            done
            new_content="${new_content%$'\n'}"
            escaped_new=$(escape_newlines "$new_content")
            # 更新该行
            sed -i "${line_num}s/.*/$date_part $escaped_new/" "$DIARY_FILE"
            echo "日记已更新！"
            ;;

        4)  # 删除日记
            echo "----- 日记列表 -----"
            nl -w2 -s'. ' "$DIARY_FILE"
            read -p "请输入要删除的日记编号: " line_num
            if ! [[ "$line_num" =~ ^[0-9]+$ ]] || [ "$line_num" -lt 1 ]; then
                echo "无效编号！"
                continue
            fi
            sed -i "${line_num}d" "$DIARY_FILE"
            echo "日记已删除！"
            ;;

        5)  # 添加待办事项
            read -p "请输入待办事项: " todo
            echo "$PENDING_MARKER $todo" >> "$TODO_FILE"
            echo "待办事项已添加！"
            ;;

        6)  # 查看待办事项
            echo "----- 待办事项 -----"
            cat "$TODO_FILE"
            ;;

        7)  # 编辑待办事项
            echo "----- 待办事项列表 -----"
            nl -w2 -s'. ' "$TODO_FILE"
            read -p "请输入要编辑的待办事项编号: " task_num
            if ! [[ "$task_num" =~ ^[0-9]+$ ]] || [ "$task_num" -lt 1 ]; then
                echo "无效编号！"
                continue
            fi
            original=$(sed -n "${task_num}p" "$TODO_FILE")
            echo "当前内容: $original"
            read -p "请输入新内容（留空保持原内容）: " new_task
            if [ -n "$new_task" ]; then
                # 保留标记符号（如果有）
                if [[ "$original" =~ ^(\[[^]]*\]) ]]; then
                    marker="${BASH_REMATCH[1]}"
                else
                    marker="$PENDING_MARKER"
                fi
                sed -i "${task_num}s/.*/$marker $new_task/" "$TODO_FILE"
                echo "已更新！"
            else
                echo "未做更改。"
            fi
            ;;

        8)  # 删除待办事项
            echo "----- 待办事项列表 -----"
            nl -w2 -s'. ' "$TODO_FILE"
            read -p "请输入要删除的待办事项编号: " task_num
            if ! [[ "$task_num" =~ ^[0-9]+$ ]] || [ "$task_num" -lt 1 ]; then
                echo "无效编号！"
                continue
            fi
            sed -i "${task_num}d" "$TODO_FILE"
            echo "待办事项已删除！"
            ;;

        9)  # 排序日记（按整行排序，日期在前所以按日期）
            echo "按日期排序日记..."
            sort -o "$DIARY_FILE" "$DIARY_FILE"
            echo "排序完成！"
            ;;

        10) # 排序待办事项（按整行）
            echo "排序待办事项..."
            sort -o "$TODO_FILE" "$TODO_FILE"
            echo "排序完成！"
            ;;

        11) # 设置
            echo "设置选项："
            echo "1. 设置日期格式"
            echo "2. 设置待办事项标记"
            echo "3. 返回"
            read -p "请选择: " set_opt
            case $set_opt in
                1)
                    read -p "请输入新日期格式（如 %Y-%m-%d）: " new_fmt
                    DATE_FORMAT="$new_fmt"
                    echo "日期格式已更新。"
                    ;;
                2)
                    read -p "新的待办标记（如 [ ]）: " new_pending
                    read -p "新的完成标记（如 [x]）: " new_done
                    PENDING_MARKER="$new_pending"
                    DONE_MARKER="$new_done"
                    echo "标记已更新。"
                    ;;
                3)
                    ;;
                *)
                    echo "无效选项。"
                    ;;
            esac
            ;;

        12)
            echo "退出程序。"
            exit 0
            ;;

        *)
            echo "无效操作！"
            ;;
    esac
done
